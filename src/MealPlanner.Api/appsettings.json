{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MealPlanner": ""
  },
  "Auth": {
    "Authority": "",
    "Audience": "meal-planner",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100
  },
  "RabbitMq": {
    "Enabled": true,
    "Uri": "",
    "Exchange": "chopchop.events",
    "PollIntervalSeconds": 2
  }
}
