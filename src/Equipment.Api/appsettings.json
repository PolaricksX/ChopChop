{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Equipment": ""
  },
  "Auth": {
    "Authority": "",
    "Issuer": "",
    "Audience": "equipment-api",
    "RequireHttpsMetadata": true,
    "ValidAlgorithms": [ "RS256", "ES256" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100
  },
  "Messaging": {
    "Enabled": false,
    "ConnectionString": ""
  }
}
